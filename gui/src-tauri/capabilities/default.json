{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GUI:t behöver bara starta sidecar-binären och lyssna på dess utdata.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/bc3-miner", "sidecar": true, "args": true }]
    }
  ]
}
